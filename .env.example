# ==================== APP ====================
PORT=3008
NODE_ENV=development
APP_HOST=localhost

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vchat
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# Prisma connection string (build from the DB variables above)
DATABASE_URL="postgresql://postgres:your_strong_password_here@localhost:5432/vchat?schema=public"

# ==================== JWT ====================
# Generate a new key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_KEY=your_access_key_here
JWT_REFRESH_KEY=your_refresh_key_here
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_EXPIRE=7d

# ==================== EMAIL ====================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="VungLEE <no-reply@example.com>"

# ==================== REDIS ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== RABBITMQ ====================
RABBITMQ_URL=amqp://guest:guest@localhost

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_LOCALHOST=true

# ==================== DEPLOYMENT ====================
# Full domain for HTTPS, for example: api.example.com
APP_DOMAIN=api.example.com

# Optional email for Let's Encrypt / Caddy certificate notices
CADDY_EMAIL=admin@example.com

# Public URL used by deploy/monitoring workflows
APP_PUBLIC_URL=http://localhost:3008

# Optional Slack incoming webhook for deploy/runtime alerts
SLACK_WEBHOOK_URL=
